{
  "domain": "igrill_ble",
  "name": "Weber iGrill BLE Sensor",
  "config_flow": true,
  "documentation": "https://github.com/miguelcaravantes/igrill",
  "dependencies": [
    "bluetooth"
  ],
  "requirements": [
    "home-assistant-bluetooth>=1.12.0",
    "sensor-state-data>=2.18.1",
    "bluetooth-sensor-state-data>=1.6.2",
    "bleak_retry_connector>=3.6.0",
    "bleak>=0.22.0"
  ],
  "codeowners": ["@miguelcaravantes"],
  "version": "1.1.0",
  "iot_class": "local_push",
  "bluetooth": [
    {
      "local_name": "iGrill*"
    }
  ]
}
